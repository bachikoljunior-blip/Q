{
  "exportVersion": "1.0",
  "exportedAt": "2026-08-01T09:00:00Z",
  "rules": [
    {
      "id": "rule-1001",
      "name": "Escalate high-priority bugs",
      "description": "Assigns new high-priority bugs and notifies an operations webhook.",
      "state": "ENABLED",
      "projectId": "10001",
      "trigger": {
        "component": "TRIGGER",
        "type": "jira.issue.created"
      },
      "components": [
        {
          "component": "CONDITION",
          "type": "jira.jql.condition",
          "jql": "project = OPS AND issuetype = Bug AND customfield_12345 = High"
        },
        {
          "component": "ACTION",
          "type": "jira.assign.issue",
          "accountId": "712020:00000000-1111-2222-3333-444444444444"
        },
        {
          "component": "ACTION",
          "type": "jira.webhook",
          "url": "https://hooks.example.test/jira/ops?token=fake-sample-token",
          "headers": {
            "Authorization": "Bearer fake-before-secret-do-not-use"
          }
        }
      ],
      "created": "2026-07-01T03:00:00Z",
      "updated": "2026-08-01T09:00:00Z"
    },
    {
      "id": "rule-1002",
      "name": "Auto close stale service requests",
      "state": "DISABLED",
      "trigger": {
        "component": "TRIGGER",
        "type": "jira.scheduled",
        "schedule": "0 0 3 * * ?"
      },
      "components": [
        {
          "component": "CONDITION",
          "type": "jira.jql.condition",
          "query": "project = HELP AND status = Waiting AND updated < -30d"
        },
        {
          "component": "ACTION",
          "type": "jira.transition.issue",
          "transitionId": "31"
        }
      ]
    },
    {
      "id": "rule-1003",
      "name": "Notify finance when invoice approved",
      "state": "ENABLED",
      "trigger": {
        "component": "TRIGGER",
        "type": "jira.issue.transitioned"
      },
      "components": [
        {
          "component": "CONDITION",
          "type": "jira.field.condition",
          "field": "customfield_15500",
          "value": "Approved"
        },
        {
          "component": "ACTION",
          "type": "jira.send.email",
          "recipientAccountId": "712020:aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee"
        }
      ]
    }
  ]
}
