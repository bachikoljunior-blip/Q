{
  "exportVersion": "1.1",
  "exportedAt": "2026-08-29T12:00:00Z",
  "rules": [
    {
      "id": "rule-1001",
      "name": "Escalate high-priority bugs",
      "description": "Assigns urgent bugs, adds an SLA label and notifies the production operations webhook.",
      "state": "ENABLED",
      "projectId": "20001",
      "trigger": {
        "component": "TRIGGER",
        "type": "jira.issue.created"
      },
      "components": [
        {
          "component": "CONDITION",
          "type": "jira.jql.condition",
          "jql": "project = OPS2 AND issuetype = Bug AND customfield_98765 in (High, Highest)"
        },
        {
          "component": "ACTION",
          "type": "jira.assign.issue",
          "accountId": "712020:99999999-8888-7777-6666-555555555555"
        },
        {
          "component": "ACTION",
          "type": "jira.edit.issue",
          "fields": {
            "labels": ["sla-watch"]
          }
        },
        {
          "component": "ACTION",
          "type": "jira.webhook",
          "url": "https://hooks.example.test/jira/production?token=fake-after-token",
          "headers": {
            "Authorization": "Bearer fake-after-secret-do-not-use"
          }
        }
      ],
      "created": "2026-07-01T03:00:00Z",
      "updated": "2026-08-29T12:00:00Z"
    },
    {
      "id": "rule-1003",
      "name": "Notify finance when invoice approved",
      "state": "ENABLED",
      "trigger": {
        "component": "TRIGGER",
        "type": "jira.issue.transitioned"
      },
      "components": [
        {
          "component": "CONDITION",
          "type": "jira.field.condition",
          "field": "customfield_15500",
          "value": "Approved"
        },
        {
          "component": "ACTION",
          "type": "jira.send.email",
          "recipientAccountId": "712020:aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee"
        }
      ]
    },
    {
      "id": "rule-1004",
      "name": "Notify security about external access",
      "state": "ENABLED",
      "trigger": {
        "component": "TRIGGER",
        "type": "jira.issue.updated"
      },
      "components": [
        {
          "component": "CONDITION",
          "type": "jira.jql.condition",
          "jql": "project = SEC AND customfield_20010 is not EMPTY"
        },
        {
          "component": "ACTION",
          "type": "jira.create.issue",
          "targetProjectId": "20077",
          "targetIssueTypeId": "10112"
        }
      ]
    }
  ]
}
