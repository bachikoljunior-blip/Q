{
  "name": "q-ash-pilgrim",
  "version": "0.17.0",
  "private": true,
  "type": "module",
  "description": "Q — 灰の巡礼 / mobile open-world action RPG",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.mjs",
    "package": "node scripts/package.mjs",
    "test:artifacts": "node scripts/stage-site.mjs && node scripts/verify-artifacts.mjs",
    "stage:site": "node scripts/stage-site.mjs",
    "test:journey": "node scripts/simulate-journey.mjs",
    "test:crossing": "node scripts/simulate-crossing.mjs",
    "test:session": "node scripts/simulate-session.mjs",
    "test:forge": "node scripts/simulate-forge.mjs",
    "test:expedition": "node scripts/simulate-expedition.mjs",
    "review:saves": "node scripts/simulate-forge.mjs --review-saves && node scripts/simulate-crossing.mjs --review-saves",
    "review:combat": "node scripts/review-combat.mjs",
    "compare:combat-view": "node scripts/compare-combat-view.mjs",
    "compare:combat-priority": "node scripts/compare-combat-priority.mjs"
  },
  "dependencies": {
    "three": "0.186.0"
  },
  "devDependencies": {
    "vite": "7.3.1"
  }
}
