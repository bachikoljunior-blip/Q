+function boundVertices(actor,bonePattern){const out=[];for(const mesh of snapshot(actor)){if(!mesh.node.isSkinnedMesh)continue;const attrs=mesh.node.geometry.attributes;for(let i=0;i<attrs.position.count;i++){const names=[];for(let k=0;k<4;k++){if(attrs.skinWeight.array[i*4+k]>0)names.push(mesh.node.skeleton.bones[attrs.skinIndex.array[i*4+k]].name);}if(!names.length||!names.every(n=>bonePattern.test(n)))continue;const row=[mesh.material,mesh.color];for(const key of ['position','normal','uv','skinIndex','skinWeight']){const a=attrs[key];row.push(...a.array.slice(i*a.itemSize,(i+1)*a.itemSize));}row.push(...mesh.positions[i].toArray());out.push(JSON.stringify(row));}}return out.sort();}
