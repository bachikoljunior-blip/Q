+const a=createDetailedActor('npc'),stats=[];for(const m of snapshot(a)){const g=m.node.geometry,p=g.attributes.position,n=g.attributes.normal,uv=g.attributes.uv,w=g.attributes.skinWeight;let zero=0,invalid=0,uvZero=0,uvNeg=0,normalMin=Infinity,weightError=0;for(let i=0;i<p.count;i++){for(const v of [p.getX(i),p.getY(i),p.getZ(i),n.getX(i),n.getY(i),n.getZ(i),uv.getX(i),uv.getY(i)])if(!Number.isFinite(v))invalid++;normalMin=Math.min(normalMin,Math.hypot(n.getX(i),n.getY(i),n.getZ(i)));if(w)weightError=Math.max(weightError,Math.abs(w.getX(i)+w.getY(i)+w.getZ(i)+w.getW(i)-1));}const idx=g.index.array;for(let f=0;f<idx.length;f+=3){const [a,b,c]=[...idx.slice(f,f+3)].map(i=>new Vector3().fromBufferAttribute(p,i));if(b.sub(a).cross(c.sub(a)).length()<1e-10)zero++;const [i,j,k]=idx.slice(f,f+3),d=(uv.getX(j)-uv.getX(i))*(uv.getY(k)-uv.getY(i))-(uv.getY(j)-uv.getY(i))*(uv.getX(k)-uv.getX(i));if(Math.abs(d)<1e-12)uvZero++;else if(d<0)uvNeg++;}stats.push({name:m.name,color:m.color,vertices:p.count,triangles:idx.length/3,zeroTriangles:zero,nonfinite:invalid,uvZero,uvNegative:uvNeg,normalMin,weightSumError:weightError});}
