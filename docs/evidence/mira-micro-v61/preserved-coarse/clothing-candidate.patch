+import{writeFileSync,readFileSync}from'node:fs';import{createDetailedActor,createBefore,snapshot,hash}from'./oracle.mjs';
+const began=performance.now(),files=['../../../src/assets/characters/detailed-geometry.js','../../../src/assets/characters/mira-garment.js'],hashes=Object.fromEntries(files.map(p=>[p,hash(readFileSync(new URL(p,import.meta.url)))]));
+const sub=(a,b)=>[a[0]-b[0],a[1]-b[1],a[2]-b[2]],dot=(a,b)=>a[0]*b[0]+a[1]*b[1]+a[2]*b[2],cross=(a,b)=>[a[1]*b[2]-a[2]*b[1],a[2]*b[0]-a[0]*b[2],a[0]*b[1]-a[1]*b[0]];
+function segment(p,q,a,b,c){const d=sub(q,p),e1=sub(b,a),e2=sub(c,a),h=cross(d,e2),det=dot(e1,h);if(Math.abs(det)<1e-11)return false;const s=sub(p,a),u=dot(s,h)/det;if(u<=1e-7||u>=1-1e-7)return false;const r=cross(s,e1),v=dot(d,r)/det;if(v<=1e-7||u+v>=1-1e-7)return false;const t=dot(e2,r)/det;return t>1e-7&&t<1-1e-7;}
+function hit(a,b){for(let k=0;k<3;k++)if(a.lo[k]>b.hi[k]||a.hi[k]<b.lo[k])return false;for(let k=0;k<3;k++)if(segment(a.p[k],a.p[(k+1)%3],...b.p)||segment(b.p[k],b.p[(k+1)%3],...a.p))return true;return false;}
+function triangles(a){const out=[];for(const [mi,m]of snapshot(a).entries()){if(!m.visible)continue;const ix=m.node.geometry.index.array;for(let i=0;i<ix.length;i+=3){const ids=[ix[i],ix[i+1],ix[i+2]],p=ids.map(i=>m.positions[i].toArray());out.push({id:mi+':'+i/3,mi,ids,name:m.name,material:m.material,kind:m.node===a.cape?'cape':m.material==='Q upper cloth'?'wool':'other',p,lo:[0,1,2].map(k=>Math.min(...p.map(v=>v[k]))),hi:[0,1,2].map(k=>Math.max(...p.map(v=>v[k])))});}}return out;}
+function contacts(a){const all=triangles(a),targets=all.filter(t=>t.kind!=='other'),pairs={},faces={cape:new Set(),wool:new Set()},samples=[];let count=0;for(const x of targets)for(const y of all){if(x.mi===y.mi&&(x.id>=y.id||x.ids.some(i=>y.ids.includes(i))))continue;if(x.kind==='wool'&&y.kind==='cape')continue;if(!hit(x,y))continue;const key=x.kind+' → '+y.name;pairs[key]=(pairs[key]||0)+1;faces[x.kind].add(x.id);if(x.mi===y.mi)faces[x.kind].add(y.id);count++;if(samples.length<32)samples.push({a:x.id,b:y.id,parts:[x.name,y.name]});}return {pairs,count,crossingFaces:Object.fromEntries(Object.entries(faces).map(([k,s])=>[k,s.size])),samples};}
