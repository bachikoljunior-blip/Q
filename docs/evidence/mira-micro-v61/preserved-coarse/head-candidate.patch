+ function firstHit(origin,target){const direction=target.clone().sub(origin).normalize(),ray=new T.Ray(origin,direction),hit=new T.Vector3();let distance=Infinity,name=null;for(const part of native)for(let f=0;f<part.index.length;f+=3){const ids=part.index;if(ray.intersectTriangle(part.vertices[ids[f]],part.vertices[ids[f+1]],part.vertices[ids[f+2]],false,hit)){const d=origin.distanceToSquared(hit);if(d<distance){distance=d;name=part.name;}}}return {material:name,distance:Math.sqrt(distance)};}
