@@ -0,0 +1,15 @@
+// Source integration boundary: apply only the proposed integration hook to the
+// actual production module in memory. Never edits shared detailed-geometry.js.
+import {registerHooks} from 'node:module';
+import {readFileSync} from 'node:fs';
+import assert from 'node:assert/strict';
+const target=new URL('../src/assets/characters/detailed-geometry.js',import.meta.url).href;
+export const HOOKS=[
+  ["import {arrowGeometry} from '../../projectile-geometry.js';","import {addMiraHair,MIRA_LID_SCALE} from './mira-hair.js';\nimport {arrowGeometry} from '../../projectile-geometry.js';"],
+  ["m.skin,[0,-.001,0],[.024,.018,.017]);","m.skin,[0,-.001,0],type==='npc'?MIRA_LID_SCALE:[.024,.018,.017]);"],
+  ["beam(head,m.hair,[s*.025,.078,.109],[s*.079,.073,.096],.007);","if(type!=='npc')beam(head,m.hair,[s*.025,.078,.109],[s*.079,.073,.096],.007);"],
+  ["const hair=mesh(head,new T.SphereGeometry(1,12,8,0,Math.PI*2,0,Math.PI*.58),m.hair,[0,.06,-.018],[.125,.147,.123]);hair.rotation.x=-.2;","if(type==='npc')addMiraHair(head,m.dark);else{const hair=mesh(head,new T.SphereGeometry(1,12,8,0,Math.PI*2,0,Math.PI*.58),m.hair,[0,.06,-.018],[.125,.147,.123]);hair.rotation.x=-.2;}"]
+];
+export function applyMiraHook(source){for(const [before,after]of HOOKS){assert.equal(source.split(before).length,2,'Mira integration anchor must occur exactly once');source=source.replace(before,after);}return source;}
+const hook=registerHooks({load(url,context,next){if(url===target)return {format:'module',source:applyMiraHook(readFileSync(new URL(target),'utf8')),shortCircuit:true};return next(url,context);}});
+export const {createDetailedActor,ACTOR_FAMILIES}=await import('../src/actor-models.js');hook.deregister();
