@@ -0,0 +1,66 @@
+// Original Q Mira short-hair masses, authored from the fixed v60 design.
+// Actual fitted scalp triangles and closed curved clumps; no portrait/card.
+import * as T from 'three';
+import {mergeGeometries} from 'three/addons/utils/BufferGeometryUtils.js';
+import {HEAD_ATTRIBUTES as A,HEAD_INDICES as I} from './identity-head-data.js';
+
+const center=new T.Vector3(0,.075,-.012),ray=new T.Ray(),a=new T.Vector3(),b=new T.Vector3(),c=new T.Vector3(),hit=new T.Vector3();
+let hairGeometry,hairMaterial,browGeometry;
+// Fitted to the preserved eye centres with the new source-aware orbital LOD.
+// Existing lid bones and .015 m closure travel are retained.
+export const MIRA_LID_SCALE=Object.freeze([.0255,.019,.019]);
+function scalp(phi,theta,lift=0){
+  const direction=new T.Vector3(Math.sin(phi)*Math.sin(theta),Math.cos(theta),Math.cos(phi)*Math.sin(theta));ray.set(center,direction);
+  let distance=Infinity,point,normal;
+  for(let f=0;f<I.length;f+=3){a.fromArray(A[I[f]]);b.fromArray(A[I[f+1]]);c.fromArray(A[I[f+2]]);if(!ray.intersectTriangle(a,b,c,false,hit))continue;const d=hit.distanceToSquared(center);if(d>=distance)continue;distance=d;point=hit.clone();normal=b.clone().sub(a).cross(c.clone().sub(a)).normalize();if(normal.dot(direction)<0)normal.negate();}
+  if(!point)throw Error('Mira hair guide missed source scalp');
+  point.addScaledVector(normal,lift);return {point,normal};
+}
+function sweep(samples,width,thickness,colors=true,tone=.75){
+  const position=[],color=[],indices=[];
+  for(let j=0;j<samples.length;j++){
+    const {point,normal}=samples[j],tangent=samples[Math.min(j+1,samples.length-1)].point.clone().sub(samples[Math.max(0,j-1)].point).normalize();
+    const across=normal.clone().cross(tangent).normalize();
+    for(let k=0;k<4;k++){
+      const angle=k*Math.PI/2,p=point.clone().addScaledVector(across,Math.cos(angle)*width[j]).addScaledVector(normal,Math.sin(angle)*thickness[j]);position.push(...p.toArray());
+      const value=tone*(1+.04*Math.cos(angle));color.push(value,value*.985,value*.95);
+    }
+  }
+  for(let j=0;j<samples.length-1;j++)for(let k=0;k<4;k++){const p=j*4+k,q=j*4+(k+1)%4,r=p+4,s=q+4;indices.push(p,q,r,r,q,s);}
+  indices.push(0,2,1,0,3,2);const end=(samples.length-1)*4;indices.push(end,end+1,end+2,end,end+2,end+3);
+  const g=new T.BufferGeometry();g.setAttribute('position',new T.Float32BufferAttribute(position,3));g.setAttribute('uv',new T.Float32BufferAttribute(Array(position.length/3*2).fill(0),2));
+  if(colors)g.setAttribute('color',new T.Float32BufferAttribute(color,3));g.setIndex(indices);g.computeVertexNormals();return g;
+}
+function base(){
+  const position=[],normal=[],uv=[],color=[],indices=[],used=new Map();
+  function within(v){const [x,y,z]=v,phi=Math.atan2(x,z+.012);return y>.060+.068*Math.cos(phi)&&(Math.abs(x)<.116||y>.13);}
+  for(let f=0;f<I.length;f+=3){const ids=I.slice(f,f+3);if(!ids.every(i=>within(A[i])))continue;
+    for(const i of ids){if(!used.has(i)){const v=A[i],n=new T.Vector3(...v.slice(3,6));used.set(i,position.length/3);position.push(v[0]+n.x*.0012,v[1]+n.y*.0012,v[2]+n.z*.0012);normal.push(n.x,n.y,n.z);uv.push(v[6],v[7]);color.push(.54,.532,.513);}indices.push(used.get(i));}
+  }
+  const g=new T.BufferGeometry();g.setAttribute('position',new T.Float32BufferAttribute(position,3));g.setAttribute('normal',new T.Float32BufferAttribute(normal,3));g.setAttribute('uv',new T.Float32BufferAttribute(uv,2));g.setAttribute('color',new T.Float32BufferAttribute(color,3));g.setIndex(indices);return g;
+}
+export function miraHairGeometry(){
+  if(hairGeometry)return hairGeometry;
+  const pieces=[base()],guides=[];
+  // Front/top flows from the character's left part toward the right forelock.
+  for(let i=0;i<10;i++)guides.push([[-.78+i*.075,.30+i*.040],[.03+i*.052,.47+i*.040],[.58+i*.047,.80+i*.033]]);
+  for(const side of[-1,1])for(let i=0;i<3;i++)guides.push([[side*(1.00+i*.19),.72],[side*(1.18+i*.20),.96],[side*(1.43+i*.20),1.22]]);
+  for(let i=0;i<8;i++){const phi=1.99+i*.33;guides.push([[phi-.10,.56],[phi,.96],[phi+.08,1.95]]);}
+  guides.forEach((guide,i)=>{const front=i<10,samples=guide.map(([p,t],j)=>scalp(p,t,j===1?(front?.012:.006):.004));pieces.push(sweep(samples,[front?.010:.008,front?.014:.010,.0012],[.002,.003,.0006],true,.64+(i%5)*.025));});
+  hairGeometry=mergeGeometries(pieces,false);if(!hairGeometry)throw Error('Mira hair merge failed');for(const p of pieces)p.dispose();
+  hairGeometry.userData={source:'Original v60 scalp-fitted base plus 24 closed three-section clumps',clumps:24};return hairGeometry;
+}
+export function miraHairMaterial(){
+  if(!hairMaterial)hairMaterial=new T.MeshStandardMaterial({name:'Q Mira hair',color:0xd9d6cf,vertexColors:true,roughness:.86,metalness:0});
+  return hairMaterial;
+}
+function brows(){
+  if(browGeometry)return browGeometry;
+  const pieces=[];for(const s of[-1,1])pieces.push(sweep([{point:new T.Vector3(s*.026,.077,.110),normal:new T.Vector3(0,0,1)},{point:new T.Vector3(s*.051,.080,.110),normal:new T.Vector3(0,0,1)},{point:new T.Vector3(s*.078,.073,.099),normal:new T.Vector3(0,0,1)}],[.0012,.0028,.0010],[.0008,.0015,.0005],false));
+  browGeometry=mergeGeometries(pieces,false);for(const p of pieces)p.dispose();return browGeometry;
+}
+export function addMiraHair(head,browMaterial){
+  for(const [name,geometry,material]of [['Mira short swept hair',miraHairGeometry(),miraHairMaterial()],['Mira shaped brows',brows(),browMaterial]]){
+    const mesh=new T.Mesh(geometry,material);mesh.name=name;mesh.castShadow=true;mesh.receiveShadow=true;head.add(mesh);
+  }
+}
