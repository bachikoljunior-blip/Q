+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {readFileSync} from 'node:fs';
+import {createHash} from 'node:crypto';
+import * as T from 'three';
+import {createDetailedActor} from './mira-head-v60-fixture.mjs';
+import {miraHairGeometry} from '../src/assets/characters/mira-hair.js';
+import {HEAD_ATTRIBUTES as A,HEAD_INDICES as I,HEAD_SOURCE_IDS as S} from '../src/assets/characters/identity-head-data.js';
+function update(a){a.g.updateMatrixWorld(true);a.g.traverse(n=>{if(n.isSkinnedMesh){n.skeleton.update();n.computeBoundingSphere();}});}
+function eyes(actor,closure){actor.time=4.7-actor.type.length*.19+.13-.095*(1-closure);actor.animate({},0);update(actor);let visible=0,centers=[];
+ for(const side of[-1,1])for(const dx of[-.01,0,.01])for(const dy of[-.005,0,.005]){const start=actor.head.localToWorld(new T.Vector3(side*.046+dx,.05+dy,.5)),dir=new T.Vector3(0,0,-1).transformDirection(actor.head.matrixWorld),hit=new T.Raycaster(start,dir,0,1).intersectObject(actor.g,true)[0];if(hit?.object.material.name==='Q eye')visible++;if(!dx&&!dy)centers.push(hit?.object.material.name);}
+ return {visible,centers};}
+test('Mira authored full-source LOD remains closed, finite and linked to its recipe',()=>{
+ const p=JSON.parse(readFileSync(new URL('../src/assets/characters/identity-head-provenance.json',import.meta.url)));
+ for(const [file,hash]of [[p.generator,p.generatorSha256],[p.designRecipe.file,p.designRecipe.sha256],['src/assets/characters/'+p.asset,p.outputSha256]])assert.equal(createHash('sha256').update(readFileSync(new URL('../'+file,import.meta.url))).digest('hex'),hash);
+ assert.equal(p.passesSourceDistanceGate,true);assert.equal(p.authoredDeformation.protectedMaximumDisplacementM,0);assert(p.authoredDeformation.maximumAuthoredDisplacementM>.005);
+ const edges=new Map();let volume=0;for(let f=0;f<I.length;f+=3){const ids=I.slice(f,f+3),v=ids.map(i=>new T.Vector3(...A[i].slice(0,3))),cross=v[1].clone().sub(v[0]).cross(v[2].clone().sub(v[0]));assert(cross.length()>1e-10);volume+=v[0].dot(v[1].clone().cross(v[2]))/6;for(let k=0;k<3;k++){const a=S[ids[k]],b=S[ids[(k+1)%3]],key=[a,b].sort((a,b)=>a-b).join('/');edges.set(key,(edges.get(key)||0)+1);}}
+ assert(volume>0);assert([...edges.values()].every(n=>n===2));for(const v of A)assert(v.every(Number.isFinite));
+});
+test('scalp plus 24 closed clumps has nonzero triangles and immutable shared clone geometry',()=>{
+ const g=miraHairGeometry(),v=g.attributes.position;assert.equal(g.userData.clumps,24);assert(g.index.count/3>480);for(let i=0;i<g.index.count;i+=3){const p=[0,1,2].map(k=>new T.Vector3().fromBufferAttribute(v,g.index.getX(i+k)));assert(p[1].sub(p[0]).cross(p[2].sub(p[0])).length()>1e-10);}
+ const a=createDetailedActor('npc'),b=createDetailedActor('npc');let ah,bh;a.g.traverse(n=>{if(n.material?.name==='Q Mira hair')ah=n;});b.g.traverse(n=>{if(n.material?.name==='Q Mira hair')bh=n;});assert(ah&&bh);assert.equal(ah.geometry,bh.geometry);assert.notEqual(ah.skeleton,bh.skeleton);const before=b.head.quaternion.clone();a.animate({healTimer:.4},.1);assert(b.head.quaternion.equals(before));
+});
+test('actual integrated head preserves central eyes and monotonic blink without hair blocking them',()=>{
+ const a=createDetailedActor('npc');let previous=Infinity;for(const c of[0,.25,.5,.75,1]){const r=eyes(a,c);assert(r.visible<=previous);previous=r.visible;if(!c)assert.deepEqual(r.centers,['Q eye','Q eye']);if(c===1)assert.equal(r.visible,0);}
+});
