new file mode 100644
index 0000000000000000000000000000000000000000..89bf3bae0db8142600b86e22ad697425e13360d2
--- /dev/null
+++ b/scripts/characters/generate-mira-head-v60.py
@@ -0,0 +1,79 @@
+#!/usr/bin/env python3
+"""Compile one authored Mira head from the original CC0 hm08 surface.
+The fixed generated art is a design guide, not measured geometry or a skin map.
+Writes only the requested output directory (default: artifacts/mira-head-v60).
+"""
+from pathlib import Path
+import sys, json, hashlib, time
+import numpy as np
+
+ROOT=Path(__file__).resolve().parents[2]
+OUTDIR=Path(sys.argv[1]).resolve() if len(sys.argv)>1 else ROOT/'artifacts/mira-head-v60'
+OUTDIR.mkdir(parents=True,exist_ok=True)
+REFERENCE=ROOT/'scripts/characters/generate-anatomical-head.py'
+DESIGN=ROOT/'src/assets/characters/mira-head-v60-design.json'
+design=json.loads(DESIGN.read_text());started=time.perf_counter();stats={}
+
+def deform(positions,ids,boundary,quads,regions):
+    original=positions.copy()
+    protected={v for vs,us in quads if regions[us[0]]!=0 for v in vs}|set(boundary)
+    anchors=positions[sorted(protected)]
+    for v in ids:
+        q=original[v];x,y,z=q
+        # Source eye/mouth interior and tucked neck retain the actual existing
+        # attachment. Surface transitions are continuous, not per-face switches.
+        distance=np.sqrt(((anchors-q)**2).sum(axis=1).min())
+        w=np.clip(distance/.016,0,1);w=w*w*(3-2*w)
+        neck=np.clip((y+.115)/.026,0,1);w*=neck*neck*(3-2*neck)
+        delta=np.zeros(3)
+        for control in design['controls']:
+            p=np.array([abs(x),y,z]) if control.get('paired') else q
+            d=(p-np.array(control['center']))/np.array(control['radius'])
+            amount=np.exp(-.5*np.dot(d,d))
+            shift=np.array(control['delta'],dtype=float)
+            if control.get('paired'):shift[0]*=np.sign(x)
+            delta+=amount*shift
+        positions[v]+=delta*w
+    tri=np.array([tuple(vs[i] for i in c) for vs,us in quads for c in [(0,1,2),(0,2,3)]])
+    def normals(a):
+        p=a[tri];return np.cross(p[:,1]-p[:,0],p[:,2]-p[:,0])
+    a,b=normals(original),normals(positions)
+    cosine=(a*b).sum(axis=1)/np.maximum(np.linalg.norm(a,axis=1)*np.linalg.norm(b,axis=1),1e-30)
+    assert cosine.min()>.65, 'New full-source fold from semantic deformation'
+    lengths=np.linalg.norm(positions[ids]-original[ids],axis=1)
+    stats.update({'sourceVertices':len(ids),'changedSourceVertices':int(np.sum(lengths>1e-7)),
+      'maximumAuthoredDisplacementM':float(lengths.max()),'minimumOriginalVsAuthoredTriangleNormalCosine':float(cosine.min()),
+      'protectedVertices':len(protected),'protectedMaximumDisplacementM':float(np.linalg.norm(positions[sorted(protected)]-original[sorted(protected)],axis=1).max()),
+      'eyePupilHeadLocal':[[s*.046,.05,.109]for s in [-1,1]],'neckBoundaryUnchanged':True,
+      'errorReference':'Full registered, collar-fitted, deliberately deformed hm08 surface. Not similarity to old face or generated reference pixels.'})
+
+source=REFERENCE.read_text()
+replacements={
+ "OUT=ROOT/'src/assets/characters/anatomical-head-data.js'":"OUT=destination/'identity-head-data.js'",
+ "PROVENANCE=ROOT/'src/assets/characters/anatomical-head-provenance.json'":"PROVENANCE=destination/'identity-head-provenance.json'",
+ 'faces={};fuvs={};':'mira_deform(positions,ids,boundary,quads,regions)\nfaces={};fuvs={};',
+ 'target=1500':'target='+str(design['lodSurfaceTriangles']),
+ "OUT.write_text(body)":"output_body=body",
+ "OUT.stat().st_size":"len(output_body.encode())",
+ "OUT.read_bytes()":"output_body.encode()",
+ "PROVENANCE.write_text(":"provenance_sink("
+}
+for old,new in replacements.items():
+    assert old in source, 'Frozen registration/LOD adapter anchor changed: '+old
+    source=source.replace(old,new)
+ns={'__file__':str(REFERENCE),'destination':OUTDIR,'mira_deform':deform,'provenance_sink':lambda text:None}
+exec(compile(source,str(REFERENCE),'exec'),ns)
+p=ns['provenance'];body=ns['output_body'].replace('Generated by scripts/characters/generate-anatomical-head.py.','Generated by scripts/characters/generate-mira-head-v60.py.')
+p.update({'asset':'identity-head-data.js','role':'npc','origin':'Original Q Mira shape authored against fixed generated multi-view design, deformed on CC0 MakeHuman hm08 geometry. No scan, portrait projection or exact likeness claim.',
+ 'generator':'scripts/characters/generate-mira-head-v60.py','generatorSha256':hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
+ 'outputSha256':hashlib.sha256(body.encode()).hexdigest(),'outputBytes':len(body.encode()),
+ 'registrationRecipe':{'file':str(REFERENCE.relative_to(ROOT)),'sha256':hashlib.sha256(REFERENCE.read_bytes()).hexdigest()},
+ 'designRecipe':{'file':str(DESIGN.relative_to(ROOT)),'sha256':hashlib.sha256(DESIGN.read_bytes()).hexdigest()},
+ 'morphSources':[],'morphsApplied':[],'authoredDeformation':stats,
+ 'application':{'method':'Semantic continuous control fields on the full registered source BEFORE endpoint QEM; original UV corner IDs and protected orbital/mouth interiors retained.',
+                'unchanged':'Other family head assets, source OBJ, eye/lid/neck bones and original skin atlas bytes.'}})
+p['passesSourceDistanceGate']=p['lod']['sourceVertexDistanceM']['max']<.0075 and p['lod']['sourceVertexDistanceM']['p95']<.0021
+assert p['passesSourceDistanceGate'], 'Authored source-to-LOD error exceeds retained approximation limits'
+(OUTDIR/'identity-head-data.js').write_text(body)
+(OUTDIR/'identity-head-provenance.json').write_text(json.dumps(p,indent=2)+'\n')
+print(json.dumps({'seconds':time.perf_counter()-started,'outputDirectory':str(OUTDIR),'lod':p['lod'],'deformation':stats,'sha256':p['outputSha256']},indent=2))
