+ const states=[{}, {state:'sealed'}, {healTimer:.45}, {state:'stagger',timer:.12,stagger:.4}, {dead:true,deathElapsed:1}];
+ let maximum=0,failures=0;const neckRows=[];for(const state of states){actor.animate(state,0);update(actor);const inverse=actor.neck.matrixWorld.clone().invert();let qmax=0;for(const i of rim){const p=new T.Vector3(...A[i].slice(0,3)).applyMatrix4(actor.head.matrixWorld).applyMatrix4(inverse),q=(p.x/.08)**2+((p.y-.018)/.12)**2+(p.z/.078)**2;qmax=Math.max(qmax,q);if(q>=1)failures++;}maximum=Math.max(maximum,qmax);neckRows.push({state,maximumEllipsoidFraction:qmax});}
