+for(const [file,entry] of Object.entries(manifest.files))if(!file.endsWith('identity-head-data.js'))assert.equal(hash(readFileSync(new URL(file,root))),entry.sha256,`unchanged comparison module ${file}`);
+const variant=process.argv[2];
+if(!['before','after'].includes(variant)){
+ const variants={};for(const name of ['before','after']){const p=spawnSync(process.execPath,[fileURLToPath(import.meta.url),name],{encoding:'utf8',maxBuffer:8*1024*1024});assert.equal(p.status,0,p.stderr);variants[name]=JSON.parse(p.stdout);}
+ const {before,after}=variants;assert.equal(before.roles.length,after.roles.length);
+ for(let i=0;i<before.roles.length;i++)if(before.roles[i].role!=='npc')assert.deepEqual(after.roles[i],before.roles[i],`unchanged role ${before.roles[i].key}`);
+ assert.equal(after.neck.failures,0);assert.equal(after.centralEyeFailures,0);
+ const b=before.roles.find(r=>r.role==='npc'),a=after.roles.find(r=>r.role==='npc');
+ const report={timestamp:new Date().toISOString(),boundary:'Actual native Three actors and indexed triangles; two isolated Node module graphs. In-memory integration hook, no renderer, pixels, device GPU, camera framing or aesthetic acceptance.',baseline:manifest.commit,variants,unchangedRoleVariants:before.roles.filter(r=>r.role!=='npc').length,delta:{triangles:a.triangles-b.triangles,visibleMeshes:a.visibleMeshes-b.visibleMeshes,geometryArrayBytes:a.geometryArrayBytes-b.geometryArrayBytes},combinedClothingCandidate:{clothingAuthorTriangles:9508,headDelta:a.triangles-b.triangles,total:9508+a.triangles-b.triangles,oldGuard:8000,adopted:false},sourceHashes:{}};
+ for(const file of ['src/assets/characters/identity-head-data.js','src/assets/characters/identity-head-provenance.json','src/assets/characters/mira-hair.js','src/assets/characters/mira-head-v60-design.json','scripts/characters/generate-mira-head-v60.py',...Object.keys(manifest.files)]){const bytes=readFileSync(new URL(file,root));report.sourceHashes[file]={bytes:bytes.length,sha256:hash(bytes)};}
+ const out=process.argv[2]??fileURLToPath(new URL('artifacts/mira-head-v60-measure.json',root));mkdirSync(fileURLToPath(new URL('./',new URL('file://'+out))),{recursive:true});writeFileSync(out,JSON.stringify(report,null,2)+'\n');console.log(JSON.stringify({out,delta:report.delta,unchangedRoleVariants:report.unchangedRoleVariants,neck:after.neck,obliqueEyeQueries:after.eyeQueries}));
+}else{
+ let api,headData;
+ if(variant==='before'){
+  const url=new URL('src/assets/characters/identity-head-data.js',root).href;
+  const hook=registerHooks({load(u,c,next){return u===url?{format:'module',source:readFileSync(new URL('source-before/identity-head-data.js',evidence),'utf8'),shortCircuit:true}:next(u,c);}});
+  api=await import(new URL('src/actor-models.js',root));headData=await import(url);hook.deregister();
+ }else{api=await import(new URL('tests/mira-head-v60-fixture.mjs',root));headData=await import(new URL('src/assets/characters/identity-head-data.js',root));}
+ const {createDetailedActor,ACTOR_FAMILIES}=api,{HEAD_ATTRIBUTES:A,HEAD_INDICES:I,HEAD_SOURCE_IDS:S}=headData;
+ function update(actor){actor.g.updateMatrixWorld(true);actor.g.traverse(n=>{if(n.isSkinnedMesh){n.skeleton.update();n.computeBoundingSphere();}});}
+ function signature(actor){const h=createHash('sha256'),geometries=new Set();let triangles=0,visibleMeshes=0,geometryArrayBytes=0;actor.g.traverseVisible(n=>{if(!n.isMesh)return;visibleMeshes++;const g=n.geometry;triangles+=(g.index?.count??g.attributes.position.count)/3;h.update(JSON.stringify([n.material.name,n.material.color?.getHex(),n.material.roughness,n.material.metalness,n.material.side,n.material.vertexColors,!!n.material.map,n.matrixWorld.toArray()]));for(const [name,attribute] of [...Object.entries(g.attributes),['index',g.index]].filter(([,v])=>v)){h.update(name);h.update(new Uint8Array(attribute.array.buffer,attribute.array.byteOffset,attribute.array.byteLength));}if(!geometries.has(g)){geometries.add(g);const buffers=new Set();for(const a of [...Object.values(g.attributes),g.index].filter(Boolean))if(!buffers.has(a.array.buffer)){buffers.add(a.array.buffer);geometryArrayBytes+=a.array.buffer.byteLength;}}});actor.g.traverse(n=>{if(n.isBone)h.update(JSON.stringify([n.name,n.position.toArray(),n.quaternion.toArray(),n.scale.toArray()]));});return {triangles,visibleMeshes,geometryArrayBytes,signature:h.digest('hex')};}
+ const roles=[];for(const [role,options] of [...ACTOR_FAMILIES.map(role=>[role,{}]),...['ember','tide','gale','moss'].map(theme=>['soldier',{theme}])]){const actor=createDetailedActor(role,options);update(actor);const rest=signature(actor);actor.animate({healTimer:.45},.1);update(actor);roles.push({key:role+(options.theme?'/'+options.theme:''),role,...rest,posedSignature:signature(actor).signature});}
