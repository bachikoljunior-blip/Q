+// Read-only native baseline probe. Does not render, edit runtime or download.
+// Run from the repository root: node docs/evidence/mira-accessories-v60/baseline.mjs
+import {build} from 'esbuild';
+import {execFileSync} from 'node:child_process';
+import path from 'node:path';
+import crypto from 'node:crypto';
+import fs from 'node:fs';
+import assert from 'node:assert/strict';
+const base='fc311bac0134b58e04891264c405bfd61eba22e3',root=process.cwd();
+const source=execFileSync('git',['show',base+':src/assets/characters/detailed-geometry.js'],{encoding:'utf8'});
+for(const file of ['src/actor-models.js','src/assets/characters/detailed-geometry.js'])assert.deepEqual(fs.readFileSync(file),execFileSync('git',['show',base+':'+file]),`${file} must be baseline`);
+const code=await build({stdin:{contents:source+`\nexport {bootGeometry,makeHuman,T}; export {createDetailedActor,animateDetailedActor} from '../../actor-models.js';`,resolveDir:path.join(root,'src/assets/characters')},bundle:true,write:false,format:'cjs',platform:'node',logLevel:'silent'});
+const module={exports:{}};new Function('module','exports',code.outputFiles[0].text)(module,module.exports);
+const {bootGeometry,makeHuman,T,createDetailedActor,animateDetailedActor}=module.exports;
+function metrics(g){
+  g.computeBoundingBox();
+  const p=g.attributes.position,idx=g.index?.array||Array.from({length:p.count},(_,i)=>i),edges=new Map(),a=new T.Vector3(),b=new T.Vector3(),c=new T.Vector3();let zero=0;
+  const key=i=>[p.getX(i),p.getY(i),p.getZ(i)].map(x=>Math.round(x*1e7)).join(',');
+  for(let i=0;i<idx.length;i+=3){
+    a.fromBufferAttribute(p,idx[i]);b.fromBufferAttribute(p,idx[i+1]);c.fromBufferAttribute(p,idx[i+2]);if(b.sub(a).cross(c.sub(a)).length()<1e-10)zero++;
+    for(let j=0;j<3;j++){const x=key(idx[i+j]),y=key(idx[i+(j+1)%3]);if(x===y)continue;const e=[x,y].sort().join('|');edges.set(e,(edges.get(e)||0)+1);}
+  }
+  return {vertices:p.count,triangles:idx.length/3,min:g.boundingBox.min.toArray(),max:g.boundingBox.max.toArray(),size:g.boundingBox.getSize(new T.Vector3()).toArray(),zeroAreaTriangles:zero,boundaryEdges:[...edges.values()].filter(x=>x===1).length,nonmanifoldEdges:[...edges.values()].filter(x=>x>2).length};
+}
+const raw=makeHuman('npc',{});raw.updateMatrixWorld(true);const rawHand=raw.getObjectByName('hand-1'),rawStaff=raw.getObjectByName('staff');let handV=0,handT=0;
+rawHand.traverse(n=>{if(!n.isMesh)return;for(let ancestor=n.parent;ancestor&&ancestor!==rawHand;ancestor=ancestor.parent)if(ancestor.name==='staff')return;handV+=n.geometry.attributes.position.count;handT+=(n.geometry.index?.count||n.geometry.attributes.position.count)/3;});
+const staffParts=rawStaff.children.map(n=>{n.updateMatrix();return {material:n.material.name,...metrics(n.geometry.clone().applyMatrix4(n.matrix))};});
+const actor=createDetailedActor('npc',{groundHeight:()=>0}),results=[];
+for(const time of [0,1,3]){
+  while(actor.time+1e-8<time)animateDetailedActor(actor,{moving:false},Math.min(1/60,time-actor.time));
+  actor.g.updateMatrixWorld(true);actor.g.traverse(n=>{if(n.isSkinnedMesh)n.skeleton.update();});
+  const hand=actor.hands[1],inverse=hand.matrixWorld.clone().invert(),staff=actor.g.getObjectByName('staff'),local=[],v=new T.Vector3();let inside=0,minRadial=Infinity;
+  actor.g.traverse(n=>{
+    if(!n.isSkinnedMesh||n.material.name!=='Q skin')return;
+    const p=n.geometry.attributes.position,bi=n.geometry.attributes.skinIndex,bw=n.geometry.attributes.skinWeight;
+    for(let i=0;i<p.count;i++){
+      let belongs=false;
+      for(let j=0;j<4;j++){const name=n.skeleton.bones[bi.getComponent(i,j)]?.name;if(bw.getComponent(i,j)>.5&&/^(hand-1|finger-1-|finger-tip-1-)/.test(name))belongs=true;}
